# Copy to .env and fill in. Never commit .env.

# Runtime mode: development | production | test. Production logs are JSON.
NODE_ENV=development
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Telegram bot token from @BotFather. Required.
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user id of the owner. The bot answers only this user. Required.
TELEGRAM_OWNER_ID=

# PostgreSQL connection string (pgvector must be installed). Required.
DATABASE_URL=postgres://user:password@localhost:5432/news_bot

# Anthropic API key. Without it, LLM scoring logs an error and is skipped.
ANTHROPIC_API_KEY=
# Model used for scoring and writing. One config value (SPEC section 8).
LLM_MODEL=claude-haiku-5-5
# LLM spend limits in USD (SPEC section 8).
LLM_DAILY_LIMIT_USD=0.16
LLM_MONTHLY_LIMIT_USD=5
# Model prices in USD per million tokens. Check them for LLM_MODEL. Used to compute the cost.
LLM_PRICE_INPUT_PER_MTOK=1
LLM_PRICE_OUTPUT_PER_MTOK=5
LLM_PRICE_CACHE_READ_PER_MTOK=0.1
LLM_PRICE_CACHE_WRITE_PER_MTOK=1.25
# The Batch API costs this fraction of the normal price. Default: 0.5
LLM_BATCH_PRICE_FACTOR=0.5

# Scoring mode: batch (Batch API, results arrive in a later run) or sync (one call per story).
SCORING_MODE=batch
# Maximum stories scored per day. Default: 100
SCORING_DAILY_CAP=100
# Characters of the item text sent to the model. Default: 1500
SCORING_MAX_CHARS=1500
# Maximum output tokens of one scoring answer. Default: 500
SCORING_MAX_OUTPUT_TOKENS=500
# Maximum output tokens of one composed digest item. Default: 800
COMPOSE_MAX_OUTPUT_TOKENS=800

# Hosted embeddings API key (Voyage or similar). Without it, items stay unclustered.
EMBEDDINGS_API_KEY=
# Embeddings endpoint and model. The model must return 1024 dimensions (docs/DB.md).
EMBEDDINGS_API_URL=https://api.voyageai.com/v1/embeddings
EMBEDDINGS_MODEL=voyage-3.5
# Story clustering: minimum cosine similarity (0-1] and time window in hours. Defaults: 0.88 and 48
DEDUP_SIMILARITY_THRESHOLD=0.88
DEDUP_WINDOW_HOURS=48

# Pre-filter: minimum cosine similarity between a story and a topic description. Default: 0.40
PREFILTER_MIN_SIMILARITY=0.40
# Pre-filter: a topic with weight 1 lowers the minimum by this value. Lower weights lower it less. Default: 0.05
PREFILTER_WEIGHT_DISCOUNT=0.05

# User-Agent sent to news sites. Use a contact address you control.
HTTP_USER_AGENT=my-news-tg-bot/0.1

# NCBI API key for PubMed. Optional. It raises the rate limit from 3 to 10 requests per second.
NCBI_API_KEY=

# Hacker News: collect only stories with at least this score. Default: 100
HN_MIN_SCORE=100

# Directory with config/*.yaml. Default: ./config
CONFIG_DIR=./config
