{
  "name": "my-news-tg-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Telegram bot that sends a personalized news digest.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "golden:export": "tsx scripts/golden-export.ts",
    "golden:build": "tsx scripts/golden-build.ts"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "franc-min": "^6.2.0",
    "grammy": "^1.48.0",
    "linkedom": "^0.18.15",
    "pino": "^10.4.0",
    "postgres": "^4.1.1",
    "rss-parser": "^3.13.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.23.0"
}
